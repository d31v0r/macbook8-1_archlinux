#!/bin/sh
# Minimal ~/.xinitrc for a bare X11 window manager. Replace the last line with your WM.
# PipeWire/WirePlumber are started by systemd user units, nothing to launch here.

xset b off
xset r rate 300 45
xset dpms 0 0 180

xbindkeys &                    # brightness / volume / media keys (see ~/.xbindkeysrc)
udiskie &                       # automount (replaces devmon)
gammastep -l 0:0 &              # set real LAT:LON, or use -l geoclue2 (replaces redshift)
xscreensaver -no-splash &

exec openbox-session
