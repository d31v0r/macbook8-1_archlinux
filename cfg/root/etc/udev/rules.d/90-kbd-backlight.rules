# Let members of the "video" group change the keyboard backlight without root.
# (The keys XF86KbdBrightnessUp/Down deliver events, but nothing writes to sysfs for you on a bare WM.)
# Add yourself:  sudo usermod -aG video "$USER"   (re-login afterwards)
SUBSYSTEM=="leds", KERNEL=="smc::kbd_backlight", RUN+="/usr/bin/chgrp video /sys/class/leds/%k/brightness", RUN+="/usr/bin/chmod g+w /sys/class/leds/%k/brightness"
